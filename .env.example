# Environment variables.
# Copy the ones you need into Vercel (Project > Settings > Environment Variables),
# or into a local .env.local for `vercel dev`.
#
# Everything below EXCEPT the VITE_* block is server-side only: those are read
# by the serverless functions under /api and never reach the browser. VITE_*
# values are inlined into the client bundle at BUILD time, which means they are
# public, and changing them requires a redeploy to take effect.

# --- X (Twitter) OAuth 2.0 ------------------------------------------------------
# Create an app at https://developer.x.com — set up "User authentication settings"
# with OAuth 2.0, type "Web App" (confidential client). Required scopes are
# tweet.read + users.read. Add your callback URL (see TWITTER_CALLBACK_URL below)
# to the app's Callback URI / Redirect URL list, exactly.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Recommended in production. Set this explicitly so www/apex domain differences
# never break the flow — it must match the Callback URL registered in the X app
# byte-for-byte. Defaults to <request-origin>/api/waitlist/twitter/callback if unset.
TWITTER_CALLBACK_URL=https://www.leviathan.run/api/waitlist/twitter/callback

# --- Session signing -----------------------------------------------------------
# Signs the short-lived OAuth cookie and the verified-identity session cookie.
# Generate one with:  openssl rand -base64 32
WAITLIST_SESSION_SECRET=

# --- Supabase storage (server-side only) ---------------------------------------
# From Supabase: Project Settings > API. Use the SERVICE ROLE key (secret), not
# the anon key — it is only ever used server-side and bypasses row-level security.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Solana RPC (client-side, PUBLIC) ------------------------------------------
# REQUIRED for the /get-levi page: wallet balances and swap submission all go
# through this endpoint. Without it the code falls back to Solana's public RPC
# (https://api.mainnet-beta.solana.com), which blocks browser traffic and answers
# every call with `403 Access forbidden` — the swap silently stops working.
#
# Use a dedicated provider (Helius, QuickNode, Alchemy, Triton). Helius format:
#   https://mainnet.helius-rpc.com/?api-key=YOUR-KEY
#
# This value ships inside the JS bundle, so treat the key as public and restrict
# it by domain in the provider dashboard. Redeploy after changing it.
VITE_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR-KEY
