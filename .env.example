# Waitlist environment variables.
# Copy the ones you need into Netlify (Site configuration > Environment variables),
# or into a local .env for `netlify dev`. None of these are exposed to the
# browser — they are read only by the Netlify Functions behind /api/waitlist.

# --- X (Twitter) OAuth 2.0 ------------------------------------------------------
# Create an app at https://developer.x.com — set up "User authentication settings"
# with OAuth 2.0, type "Web App" (confidential client). Required scopes are
# tweet.read + users.read. Add your callback URL (see TWITTER_CALLBACK_URL below)
# to the app's Callback URI / Redirect URL list, exactly.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Optional. Defaults to <request-origin>/api/waitlist/twitter/callback, which is
# correct for a single domain. Set it explicitly in production so it always
# matches the callback registered in the X app (must be byte-for-byte identical).
# TWITTER_CALLBACK_URL=https://leviathan.run/api/waitlist/twitter/callback

# --- Session signing -----------------------------------------------------------
# Signs the short-lived OAuth cookie and the verified-identity session cookie.
# Generate one with:  openssl rand -base64 32
WAITLIST_SESSION_SECRET=

# --- Supabase storage (server-side only) ---------------------------------------
# From Supabase: Project Settings > API. Use the SERVICE ROLE key (secret), not
# the anon key — it is only ever used server-side and bypasses row-level security.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
